# Скопируйте в .env и заполните на сервере. .env не попадает в git.
# Токены не отправляйте в чат — ни боту, ни кому-либо ещё.
# Комментарии — только на отдельных строках: docker compose не отрезает «# …» после пустого значения.

# Telegram: токен от @BotFather. ID владельца бот сообщит сам при первом /start.
INVESTBOT_TELEGRAM_BOT_TOKEN=
INVESTBOT_OWNER_TELEGRAM_ID=
# Если с сервера нет прямого доступа к api.telegram.org (docs/DEPLOY.md, раздел 9): socks5://vpn:1080 — через
# VPN-подписку, socks5://tunnel:1080 — через свой сервер, или адрес готового SOCKS5/HTTP-прокси
INVESTBOT_TELEGRAM_PROXY=

# Т-Инвестиции: токен ТОЛЬКО ЧТЕНИЕ (Настройки → Токены T-Invest API). С полным доступом бот не запустится.
INVESTBOT_TINVEST_TOKEN=
# Или несколько токенов по счетам: INVESTBOT_TINVEST_TOKENS={"main":"t.…","iis":"t.…"}
# Режим без токена (счета Т-Инвестиций вручную): INVESTBOT_TINVEST_SYNC=false

# Корневые сертификаты: системные + Минцифры (docs/DEPLOY.md, шаг 4; локально — `investbot certs`)
INVESTBOT_CA_BUNDLE=data/local/ca-bundle.pem

# weights — в Telegram только доли (по умолчанию); full — с рублёвыми суммами
INVESTBOT_PRIVACY_MODE=weights

# LLM: свой OpenAI-совместимый провайдер (заменяет провайдеров из config/llm.yaml). Без него бот работает без
# текстовых пояснений, тона новостей и вопросов аналитику.
# Адрес до /v1, без /chat/completions, например https://api.provider.example/v1
INVESTBOT_LLM_BASE_URL=
INVESTBOT_LLM_API_KEY=
# Точный id модели для отчёта и вопросов (список: GET <BASE_URL>/models)
INVESTBOT_LLM_MODEL=
# Дешёвая модель для разметки новостей (необязательно; по умолчанию та же)
INVESTBOT_LLM_MODEL_FAST=
# true — провайдер хранит и обрабатывает данные в РФ
INVESTBOT_LLM_DATA_IN_RU=false
# Если провайдер за рубежом: портфельные данные (доли классов и бумаг, без сумм) ему по умолчанию НЕ отправляются,
# и комментарий к отчёту, вопросы аналитику и обсуждение аллокации не работают. Разрешить — осознанное решение:
INVESTBOT_LLM_ALLOW_PORTFOLIO_ABROAD=false
# Цены в ₽ за 1M входных / выходных токенов — для месячного бюджета
INVESTBOT_LLM_PRICE_IN=300
INVESTBOT_LLM_PRICE_OUT=1200
# Месячный лимит, ₽: при 90% — экономный режим, при 100% — отчёт по шаблону без LLM
INVESTBOT_LLM_MONTHLY_RUB=3000
# Модель умеет вызывать функции (нужно для вопросов аналитику)
INVESTBOT_LLM_SUPPORTS_TOOLS=true
# socks5://tunnel:1080 — если провайдер недоступен с сервера напрямую
INVESTBOT_LLM_PROXY=

# Альтернатива — провайдеры из config/llm.yaml (Cloud.ru, Yandex AI Studio) по их ключам:
# CLOUDRU_API_KEY=
# YC_API_KEY=
# YC_FOLDER_ID=

# --- Только для docker compose на сервере (docs/DEPLOY.md) ---
# Владелец каталога data/local: шаг 5 дописывает сюда INVESTBOT_UID / INVESTBOT_GID (вывод `id -u` / `id -g`).
# Прокси через VPN-подписку (раздел 9.1): COMPOSE_PROFILES=vpn, подписка — в secrets/vpn_subscription
# COMPOSE_PROFILES=vpn
# Туннель к зарубежному серверу (профиль tunnel, раздел 9.2):
# TUNNEL_HOST=
# TUNNEL_USER=tunnel
